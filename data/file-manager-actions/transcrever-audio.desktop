[Desktop Entry]
Type=Action
Name=Transcrever áudio com BIG
Name[pt_BR]=Transcrever áudio com BIG
Name[en]=Transcribe audio with BIG
Tooltip=Gera transcrição forense (TXT + MD + PDF) com SHA-256 e cadeia de custódia.
Tooltip[pt_BR]=Gera transcrição forense (TXT + MD + PDF) com SHA-256 e cadeia de custódia.
Icon=bigcertificados
Profiles=on_audio

# Profile: arquivos de áudio suportados pelo faster-whisper
[X-Action-Profile on_audio]
MimeTypes=audio/mpeg;audio/mp4;audio/x-m4a;audio/ogg;audio/opus;audio/wav;audio/x-wav;audio/flac;audio/x-flac;
Exec=big-advogados transcrever %F
